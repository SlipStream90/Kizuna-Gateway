DATABASE_URL=postgresql://postgres:postgres@localhost:5432/kizuna
CORS_ORIGINS=http://localhost:3000
# Local development only: lets the web client mint a token from POST /api/v1/dev/session.
# Leave unset (or 0) anywhere real OIDC tokens are issued.
DEV_AUTH_ENABLED=1
DEV_ORG_ID=11111111-1111-1111-1111-111111111111
DEV_TOKEN_TTL_SECONDS=3600

# --- Real identity provider (Keycloak, or any OIDC issuer) ---
# Algorithm must match how the issuer signs. With a real provider set DEV_AUTH_ENABLED=0.
#   OIDC_ISSUER=http://localhost:8080/realms/kizuna
#   OIDC_AUDIENCE=kizuna-pilot
#   OIDC_JWT_ALGORITHM=RS256
#   OIDC_JWKS_URL=            # optional: skips discovery
#   OIDC_ORG_CLAIM=org_id     # or nested: realm_access.kizuna-web.roles
#   OIDC_ROLES_CLAIM=roles    # or nested: realm_access.roles
#   OIDC_LEEWAY_SECONDS=60

# --- Liquid AI speech-to-speech (LFM2.5-Audio-1.5B-JP) ---
# Set LFM_MODEL_ID to override the model. Installs: pip install liquid-audio soundfile torch
# For CUDA: pip install torch --index-url https://download.pytorch.org/whl/cu118
LFM_MODEL_ID=LiquidAI/LFM2.5-Audio-1.5B-JP

# --- Translation (optional NLLB-200 model) ---
# Weights are only used from the local Hugging Face cache. Set to 1 to let the first
# translate request download them (~2.4 GB); left unset, a labelled fallback is returned.
# TRANSLATE_NLLB_DOWNLOAD=1

# --- Statutory RAG (app/rag) ---
# GROQ_API_KEY=                 # enables grounded answers on POST /api/v1/compliance/answer
# RAG_GENERATION_MODEL=openai/gpt-oss-120b   # or openai/gpt-oss-20b, qwen/qwen3.8-27b (strict JSON schema)
# RAG_EMBEDDING_BACKEND=sentence-transformers   # or 'hashing' for tests/offline
# RAG_MIN_EVIDENCE_SIMILARITY=0.35
# RAG_INGEST_DATABASE_URL=     # writer role for python -m app.rag.ingest (defaults to DATABASE_URL)
