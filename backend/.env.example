DATABASE_URL=postgresql://postgres:postgres@localhost:5432/kizuna
CORS_ORIGINS=http://localhost:3000
# Local development only: lets the web client mint a token from POST /api/v1/dev/session.
# Leave unset (or 0) anywhere real OIDC tokens are issued.
DEV_AUTH_ENABLED=1
DEV_ORG_ID=11111111-1111-1111-1111-111111111111
DEV_TOKEN_TTL_SECONDS=3600
