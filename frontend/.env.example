NEXT_PUBLIC_API_BASE_URL=/api/v1

# --- OIDC login (BFF) ---
# The BFF proxy attaches tokens server-side, so nothing below reaches the browser.
# APP_URL must match the exact scheme://host:port Keycloak redirects back to.
APP_URL=http://localhost:3000
OIDC_ISSUER=http://localhost:8080/realms/kizuna
OIDC_CLIENT_ID=kizuna-web
OIDC_CLIENT_SECRET=kizuna-web-dev-secret

# Session cookie sealing. Generate with: openssl rand -base64 32
AUTH_SESSION_SECRET=replace-me-with-a-32-byte-random-secret

# Claims emitted by the provider (adjust for other IdPs).
OIDC_ORG_CLAIM=org_id
OIDC_ROLES_CLAIM=roles

# BFF proxy upstream and dev fallback.
API_ORIGIN=http://localhost:8000
# DEV_AUTH_FALLBACK=1 lets the proxy mint a backend dev token when IdP is absent.
DEV_AUTH_FALLBACK=0

# Set to 1 only when terminating TLS locally.
COOKIE_SECURE=0
# --- JIG-OS (optional) ---
# Enables "Refine wording with Claude" on /jig-os. Everything else runs without it.
ANTHROPIC_API_KEY=

# --- Supabase (auth + data) ---
# Project URL and publishable key are public; the secret key is server-only and bypasses RLS.
NEXT_PUBLIC_SUPABASE_URL=https://<project-ref>.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_...
SUPABASE_SECRET_KEY=
